# Normaliza los finales de linea en el repositorio (LF dentro de git).
* text=auto eol=lf

# Scripts de Windows: deben conservar CRLF en el disco.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binarios: git no debe tocarlos nunca.
*.woff2 binary
*.ico   binary
*.png   binary
*.jpg   binary
*.dll   binary
*.lib   binary
*.node  binary
